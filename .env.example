# Server Port
PORT=5005

# JWT Auth Secret
JWT_SECRET=super_secret_devmirror_token_key_123

# Database Connection (Optional, fallbacks to local SQLite if omitted)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/devmirror

# AI Provider: gemini | openai
AI_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (when AI_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
